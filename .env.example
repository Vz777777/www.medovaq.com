# Medovaq B2B Production Server Configuration

# Application Port
PORT=5000

# Administrative Dashboard Password
# WARNING: Change this password in production to secure your CRM submissions and blog actions!
ADMIN_PASSWORD=login777

# CORS Allowed Origin
# Set to your production domain (e.g., https://www.medovaq.com) or use '*' for global B2B integrations
CORS_ORIGIN=*

# SMTP Transactional Mail Configuration
# Set these values to enable automated RFQ email alerts to the sales team and client receipts.
# If left blank, RFQ submissions will be saved locally to data/ files but no emails will be sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=sales@medovaq.com

# Receiver email for CRM lead alerts
RECEIVER_EMAIL=leads@medovaq.com
